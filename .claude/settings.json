{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let s='';process.stdin.on('data',c=>s+=c).on('end',()=>process.stdout.write(JSON.parse(s).tool_input?.file_path??''))\" | { read -r f; [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/biome\" check --write --no-errors-on-unmatched --files-ignore-unknown=true \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatando com o Biome..."
          }
        ]
      }
    ]
  }
}
